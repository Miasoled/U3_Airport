@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-page">
    <div class="auth-panel">
        <aside class="auth-aside">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-brand">
                <span class="brand-mark" aria-hidden="true">✈</span>
                AirportApp
            </a>

            <div class="auth-aside-content">
                <span class="auth-kicker">Bienvenido de nuevo</span>
                <h1>Gestiona tu viaje con tranquilidad.</h1>
                <p>
                    Consulta tus reservas, cambia de vuelo y revisa el estado de tus operaciones
                    desde un solo lugar.
                </p>
            </div>

            <div class="auth-route" aria-hidden="true">
                <span class="auth-route-point"></span>
                <span class="auth-route-line"></span>
                <span class="auth-route-plane">✈</span>
            </div>
        </aside>

        <section class="auth-form-section">
            <div class="auth-form-wrap">
                <div class="mb-4">
                    <span class="auth-kicker">Acceso seguro</span>
                    <h2 class="h2 mb-2">Iniciar sesión</h2>
                    <p class="text-muted mb-0">Ingresa con el correo registrado en tu cuenta.</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                        <input asp-for="Input.Email" class="form-control auth-input"
                               autocomplete="username" aria-required="true"
                               placeholder="nombre@correo.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <label asp-for="Input.Password" class="form-label">Contraseña</label>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="auth-small-link">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>
                        <input asp-for="Input.Password" class="form-control auth-input"
                               autocomplete="current-password" aria-required="true"
                               placeholder="Ingresa tu contraseña" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Mantener mi sesión iniciada</label>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-dark btn-lg">
                        Ingresar
                    </button>

                    <p class="auth-switch mb-0 mt-4">
                        ¿Todavía no tienes una cuenta?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Crear cuenta</a>
                    </p>

                    <div class="text-center mt-2">
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="auth-small-link">
                            Reenviar confirmación de correo
                        </a>
                    </div>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="auth-divider"><span>o continúa con</span></div>
                    <form id="external-account" asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-secondary"
                                    name="provider" value="@provider.Name">
                                @provider.DisplayName
                            </button>
                        }
                    </form>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
