@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm text-center">
                <div class="card-body p-4 p-md-5">
                    <div class="access-denied-icon mx-auto mb-4" aria-hidden="true">!</div>
                    <div class="text-uppercase small fw-semibold text-danger mb-2">
                        Autorización requerida
                    </div>
                    <h1 class="h2 mb-3">Acceso denegado</h1>
                    <p class="text-muted mb-4">
                        Tu sesión está activa, pero tu rol no tiene permisos para acceder a esta sección.
                        Las funciones administrativas requieren el rol <strong>Administrador</strong>.
                    </p>

                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            Volver al inicio
                        </a>
                        <a asp-area="" asp-controller="FlightReprogramming" asp-action="Index"
                           class="btn btn-outline-secondary">
                            Ir a mis reservas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
