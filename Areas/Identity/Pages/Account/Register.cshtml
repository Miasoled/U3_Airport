@page
@model RegisterModel

@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-page">
    <div class="auth-panel">
        <aside class="auth-aside auth-aside-register">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-brand">
                <span class="brand-mark" aria-hidden="true">✈</span>
                AirportApp
            </a>

            <div class="auth-aside-content">
                <span class="auth-kicker">Comienza tu viaje</span>
                <h1>Tu próxima reserva empieza aquí.</h1>
                <p>
                    Regístrate como Cliente para crear reservas, seleccionar vuelos alternativos
                    y consultar tu historial personal.
                </p>
            </div>

            <div class="auth-benefits">
                <span>Reservas asociadas a tu correo</span>
                <span>Pagos seguros con PayPal Sandbox</span>
                <span>Historial individual de operaciones</span>
            </div>
        </aside>

        <section class="auth-form-section">
            <div class="auth-form-wrap">
                <div class="mb-4">
                    <span class="auth-kicker">Registro de cliente</span>
                    <h2 class="h2 mb-2">Crear una cuenta</h2>
                    <p class="text-muted mb-0">Completa los datos para acceder al sistema.</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                        <input asp-for="Input.Email" class="form-control auth-input"
                               autocomplete="username" aria-required="true"
                               placeholder="nombre@correo.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Contraseña</label>
                        <input asp-for="Input.Password" class="form-control auth-input"
                               autocomplete="new-password" aria-required="true"
                               placeholder="Mínimo 6 caracteres" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        <div class="form-text">Debe incluir mayúscula, minúscula, número y símbolo.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control auth-input"
                               autocomplete="new-password" aria-required="true"
                               placeholder="Repite tu contraseña" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-dark btn-lg">
                        Crear cuenta
                    </button>

                    <p class="auth-switch mb-0 mt-4">
                        ¿Ya tienes una cuenta?
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Iniciar sesión</a>
                    </p>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="auth-divider"><span>o regístrate con</span></div>
                    <form id="external-account" asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-secondary"
                                    name="provider" value="@provider.Name">
                                @provider.DisplayName
                            </button>
                        }
                    </form>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
