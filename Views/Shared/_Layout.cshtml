<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - U3_Examen_Airport</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/U3_Examen_Airport.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg airport-navbar mb-3">
            <div class="container">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">✈</span>
                    AirportApp
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Reservations"
                                   asp-action="Index">
                                    Nueva Reserva
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-area=""
                                asp-controller="FlightReprogramming"
                                asp-action="Index">
                                    Reprogramar vuelo
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="FlightReprogramming"
                                   asp-action="History">
                                    Mi historial
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Administration"
                                   asp-action="Index">
                                    Zona administrativa
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   id="administrationDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Catálogos
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="administrationDropdown">
                                    <li><a class="dropdown-item" asp-controller="Airlines" asp-action="Index">Aerolíneas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Airports" asp-action="Index">Aeropuertos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Index">Reservas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Flights" asp-action="Index">Vuelos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Passengers" asp-action="Index">Pasajeros</a></li>
                                </ul>
                            </li>
                        }

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container app-shell">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="airport-footer">
        <div class="container">
            <div class="d-flex flex-column flex-sm-row justify-content-between gap-2">
                <span>&copy; 2026 AirportApp</span>
                <span>Reservas y reprogramación de vuelos</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
