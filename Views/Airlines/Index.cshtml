@model IEnumerable<U3_Examen_Airport.Models.Airline>

@{
    ViewData["Title"] = "Aerolíneas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">Aerolíneas</h1><p class="text-muted mb-0">Administración de aerolíneas registradas.</p></div>
    <a asp-action="Create" class="btn btn-dark">Nueva aerolínea</a>
</div>
<div class="card"><div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Iata)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Airlinename)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BaseAirport)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Iata)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Airlinename)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BaseAirport)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AirlineId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AirlineId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AirlineId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div><div class="card-body pt-2"><partial name="_AdminPagination" /></div></div>
