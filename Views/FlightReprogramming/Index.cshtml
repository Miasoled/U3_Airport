@using U3_Examen_Airport.Models

@{
    ViewData["Title"] = "Reprogramar vuelo";

    Booking? booking = ViewBag.Booking as Booking;
    Passenger? passenger = ViewBag.Passenger as Passenger;
    Airport? originAirport = ViewBag.OriginAirport as Airport;
    Airport? destinationAirport = ViewBag.DestinationAirport as Airport;
    List<Booking> userBookings = ViewBag.UserBookings as List<Booking> ?? new List<Booking>();
    Dictionary<int, string> airportNames =
        ViewBag.AirportNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    bool passengerNotLinked = ViewBag.PassengerNotLinked is true;
    string searchText = ViewBag.SearchText as string ?? string.Empty;
    DateTime? dateFrom = ViewBag.DateFrom as DateTime?;
    DateTime? dateTo = ViewBag.DateTo as DateTime?;
    string sortOrder = ViewBag.SortOrder as string ?? "booking_desc";
    int currentPage = ViewBag.CurrentPage is int valueCurrentPage ? valueCurrentPage : 1;
    int pageSize = ViewBag.PageSize is int valuePageSize ? valuePageSize : 10;
    int totalRecords = ViewBag.TotalRecords is int valueTotalRecords ? valueTotalRecords : 0;
    int totalPages = ViewBag.TotalPages is int valueTotalPages ? valueTotalPages : 1;
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h1 class="h4 mb-0">Mis reservas</h1>
                </div>

                <div class="card-body">
                    @if (!passengerNotLinked)
                    {
                        <form asp-action="Index" method="get" class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label for="searchText" class="form-label">Número de vuelo</label>
                                <input id="searchText"
                                       name="searchText"
                                       value="@searchText"
                                       class="form-control"
                                       placeholder="Ejemplo: LH123" />
                            </div>

                            <div class="col-md-3">
                                <label for="dateFrom" class="form-label">Salida desde</label>
                                <input id="dateFrom"
                                       name="dateFrom"
                                       type="date"
                                       value="@(dateFrom?.ToString("yyyy-MM-dd"))"
                                       class="form-control" />
                            </div>

                            <div class="col-md-3">
                                <label for="dateTo" class="form-label">Salida hasta</label>
                                <input id="dateTo"
                                       name="dateTo"
                                       type="date"
                                       value="@(dateTo?.ToString("yyyy-MM-dd"))"
                                       class="form-control" />
                            </div>

                            <div class="col-md-2">
                                <label for="pageSize" class="form-label">Por página</label>
                                <select id="pageSize" name="pageSize" class="form-select">
                                    <option value="5" selected="@(pageSize == 5)">5</option>
                                    <option value="10" selected="@(pageSize == 10)">10</option>
                                    <option value="20" selected="@(pageSize == 20)">20</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label for="sortOrder" class="form-label">Ordenar por</label>
                                <select id="sortOrder" name="sortOrder" class="form-select">
                                    <option value="booking_desc" selected="@(sortOrder == "booking_desc")">Reserva más reciente</option>
                                    <option value="departure_asc" selected="@(sortOrder == "departure_asc")">Salida ascendente</option>
                                    <option value="departure_desc" selected="@(sortOrder == "departure_desc")">Salida descendente</option>
                                    <option value="price_asc" selected="@(sortOrder == "price_asc")">Precio menor</option>
                                    <option value="price_desc" selected="@(sortOrder == "price_desc")">Precio mayor</option>
                                </select>
                            </div>

                            <div class="col-md-8 d-flex align-items-end gap-2">
                                <button type="submit" class="btn btn-primary">Buscar y filtrar</button>
                                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                            </div>
                        </form>
                    }

                    @if (passengerNotLinked)
                    {
                        <div class="alert alert-warning mb-0">
                            No se encontró un pasajero asociado al correo de esta cuenta.
                            Puede buscar una reserva manualmente usando el número de reserva y el pasaporte.
                        </div>
                    }
                    else if (userBookings.Count == 0)
                    {
                        <div class="alert alert-info mb-0">
                            No se encontraron reservas con los criterios seleccionados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Reserva</th>
                                        <th>Vuelo</th>
                                        <th>Origen</th>
                                        <th>Destino</th>
                                        <th>Salida</th>
                                        <th>Llegada</th>
                                        <th>Asiento</th>
                                        <th>Precio</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var userBooking in userBookings)
                                    {
                                        var currentFlight = userBooking.Flight;
                                        var originName = airportNames.TryGetValue(
                                            currentFlight.From,
                                            out var foundOriginName)
                                            ? foundOriginName
                                            : currentFlight.From.ToString();
                                        var destinationName = airportNames.TryGetValue(
                                            currentFlight.To,
                                            out var foundDestinationName)
                                            ? foundDestinationName
                                            : currentFlight.To.ToString();

                                        <tr>
                                            <td>@userBooking.BookingId</td>
                                            <td>@currentFlight.Flightno</td>
                                            <td>@originName</td>
                                            <td>@destinationName</td>
                                            <td>@(currentFlight.Departure.ToString("dd/MM/yyyy HH:mm"))</td>
                                            <td>@(currentFlight.Arrival.ToString("dd/MM/yyyy HH:mm"))</td>
                                            <td>@(userBooking.Seat ?? "—")</td>
                                            <td>$@userBooking.Price.ToString("N2")</td>
                                            <td>
                                                <a asp-controller="FlightReprogramming"
                                                   asp-action="SelectFlight"
                                                   asp-route-bookingId="@userBooking.BookingId"
                                                   class="btn btn-success btn-sm">
                                                    Reprogramar
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                            <div class="text-muted">
                                Página @currentPage de @totalPages · @totalRecords registros · @pageSize por página
                            </div>

                            <nav aria-label="Paginación de reservas">
                                <ul class="pagination mb-0">
                                    <li class="page-item @(currentPage <= 1 ? "disabled" : null)">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-searchText="@searchText"
                                           asp-route-dateFrom="@(dateFrom?.ToString("yyyy-MM-dd"))"
                                           asp-route-dateTo="@(dateTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-sortOrder="@sortOrder"
                                           asp-route-pageSize="@pageSize"
                                           asp-route-page="@(currentPage - 1)">
                                            Anterior
                                        </a>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link">@currentPage</span>
                                    </li>
                                    <li class="page-item @(currentPage >= totalPages ? "disabled" : null)">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-searchText="@searchText"
                                           asp-route-dateFrom="@(dateFrom?.ToString("yyyy-MM-dd"))"
                                           asp-route-dateTo="@(dateTo?.ToString("yyyy-MM-dd"))"
                                           asp-route-sortOrder="@sortOrder"
                                           asp-route-pageSize="@pageSize"
                                           asp-route-page="@(currentPage + 1)">
                                            Siguiente
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h1 class="h4 mb-0">
                        Cambio y reprogramación de vuelos
                    </h1>
                </div>

                <div class="card-body">

                    <p class="text-muted">
                        Ingrese el número de reserva y el pasaporte
                        correspondiente al pasajero.
                    </p>

                    <form asp-controller="FlightReprogramming"
                          asp-action="Index"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">
                                    Número de reserva
                                </label>

                                <input type="number"
                                       name="bookingId"
                                       class="form-control"
                                       min="1"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Número de pasaporte
                                </label>

                                <input type="text"
                                       name="passportNumber"
                                       class="form-control"
                                       maxlength="9"
                                       required />
                            </div>

                        </div>

                        <div class="mt-4">
                            <button type="submit"
                                    class="btn btn-primary">
                                Buscar reserva
                            </button>
                        </div>

                    </form>

                    @if (ViewBag.ErrorMessage is not null)
                    {
                        <div class="alert alert-warning mt-4">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                </div>
            </div>

            @if (booking is not null
                 && passenger is not null
                 && booking.Flight is not null)
            {
                <div class="card shadow-sm mt-4">

                    <div class="card-header">
                        <h2 class="h5 mb-0">
                            Reserva encontrada
                        </h2>
                    </div>

                    <div class="card-body">

                        <div class="row g-3">

                            <div class="col-md-4">
                                <strong>Reserva</strong>
                                <div>@booking.BookingId</div>
                            </div>

                            <div class="col-md-4">
                                <strong>Pasajero</strong>
                                <div>
                                    @passenger.Firstname
                                    @passenger.Lastname
                                </div>
                            </div>

                            <div class="col-md-4">
                                <strong>Pasaporte</strong>
                                <div>@passenger.Passportno</div>
                            </div>

                            <div class="col-md-4">
                                <strong>Vuelo</strong>
                                <div>@booking.Flight.Flightno</div>
                            </div>

                            <div class="col-md-4">
                                <strong>Origen</strong>
                                <div>
                                    @(originAirport?.Name ?? "Sin información")
                                </div>
                            </div>

                            <div class="col-md-4">
                                <strong>Destino</strong>
                                <div>
                                    @(destinationAirport?.Name ?? "Sin información")
                                </div>
                            </div>

                            <div class="col-md-4">
                                <strong>Salida</strong>
                                <div>
                                    @(booking.Flight.Departure.ToString("dd/MM/yyyy HH:mm"))
                                </div>
                            </div>

                            <div class="col-md-4">
                                <strong>Llegada</strong>
                                <div>
                                    @(booking.Flight.Arrival.ToString("dd/MM/yyyy HH:mm"))
                                </div>
                            </div>

                            <div class="col-md-2">
                                <strong>Asiento</strong>
                                <div>@booking.Seat</div>
                            </div>

                            <div class="col-md-2">
                                <strong>Precio</strong>
                                <div>
                                    $@booking.Price.ToString("N2")
                                </div>
                            </div>

                        </div>

                        <hr />

                        <a asp-controller="FlightReprogramming"
                           asp-action="SelectFlight"
                           asp-route-bookingId="@booking.BookingId"
                           class="btn btn-success">
                            Buscar vuelos alternativos
                        </a>

                    </div>
                </div>
            }

        </div>
    </div>
</div>
