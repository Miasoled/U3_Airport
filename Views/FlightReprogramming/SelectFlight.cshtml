@model IEnumerable<U3_Examen_Airport.Models.Flight>
@using U3_Examen_Airport.Models

@{
    ViewData["Title"] = "Seleccionar nuevo vuelo";

    Booking? booking = ViewBag.Booking as Booking;
    string originAirportName = ViewBag.OriginAirportName as string ?? "Sin información";
    string destinationAirportName = ViewBag.DestinationAirportName as string ?? "Sin información";
}

<div class="container py-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h1 class="h4 mb-0">
                Vuelos alternativos
            </h1>
        </div>

        <div class="card-body">

            @if (booking?.Flight is not null)
            {
                <div class="card border-info mb-4">
                    <div class="card-header bg-info-subtle">
                        <h2 class="h5 mb-0">Vuelo actual</h2>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4"><strong>Reserva</strong><div>@booking.BookingId</div></div>
                            <div class="col-md-4"><strong>Vuelo</strong><div>@booking.Flight.Flightno</div></div>
                            <div class="col-md-4"><strong>Precio actual</strong><div>$@booking.Price.ToString("N2")</div></div>
                            <div class="col-md-6"><strong>Origen</strong><div>@originAirportName</div></div>
                            <div class="col-md-6"><strong>Destino</strong><div>@destinationAirportName</div></div>
                            <div class="col-md-6"><strong>Salida</strong><div>@(booking.Flight.Departure.ToString("dd/MM/yyyy HH:mm"))</div></div>
                            <div class="col-md-6"><strong>Llegada</strong><div>@(booking.Flight.Arrival.ToString("dd/MM/yyyy HH:mm"))</div></div>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-warning">
                    No se encontraron vuelos alternativos
                    para la misma ruta.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Vuelo</th>
                                <th>Salida</th>
                                <th>Llegada</th>
                                <th>Origen</th>
                                <th>Destino</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var flight in Model)
                            {
                                <tr>
                                    <td>@flight.Flightno</td>

                                    <td>
                                        @(flight.Departure.ToString("dd/MM/yyyy HH:mm"))
                                    </td>

                                    <td>
                                        @(flight.Arrival.ToString("dd/MM/yyyy HH:mm"))
                                    </td>

                                    <td>@originAirportName</td>

                                    <td>@destinationAirportName</td>

                                    <td>
                                        <a asp-controller="FlightReprogramming"
                                           asp-action="SelectSeat"
                                           asp-route-bookingId="@booking?.BookingId"
                                           asp-route-newFlightId="@flight.FlightId"
                                           class="btn btn-success btn-sm">
                                            Seleccionar
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            }

            <a asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>

        </div>
    </div>
</div>
