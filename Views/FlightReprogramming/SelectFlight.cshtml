@model IEnumerable<U3_Examen_Airport.Models.Flight>
@using U3_Examen_Airport.Models

@{
    ViewData["Title"] = "Seleccionar nuevo vuelo";

    Booking? booking = ViewBag.Booking as Booking;
}

<div class="container py-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h1 class="h4 mb-0">
                Vuelos alternativos
            </h1>
        </div>

        <div class="card-body">

            @if (booking?.Flight is not null)
            {
                <div class="alert alert-info">

                    <strong>Vuelo actual:</strong>
                    @booking.Flight.Flightno

                    <br />

                    <strong>Salida:</strong>
                    @booking.Flight.Departure
                        .ToString("dd/MM/yyyy HH:mm")

                    <br />

                    <strong>Precio actual:</strong>
                    $@booking.Price.ToString("N2")

                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-warning">
                    No se encontraron vuelos alternativos
                    para la misma ruta.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Vuelo</th>
                                <th>Salida</th>
                                <th>Llegada</th>
                                <th>Origen</th>
                                <th>Destino</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var flight in Model)
                            {
                                <tr>
                                    <td>@flight.Flightno</td>

                                    <td>
                                        @flight.Departure
                                            .ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @flight.Arrival
                                            .ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>@flight.From</td>

                                    <td>@flight.To</td>

                                    <td>
                                        <a asp-controller="FlightReprogramming"
                                           asp-action="Compare"
                                           asp-route-bookingId="@booking?.BookingId"
                                           asp-route-newFlightId="@flight.FlightId"
                                           class="btn btn-success btn-sm">
                                            Seleccionar
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            }

            <a asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>

        </div>
    </div>
</div>