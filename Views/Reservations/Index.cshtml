@model IEnumerable<U3_Examen_Airport.Models.Flight>

@{
    ViewData["Title"] = "Nueva Reserva";
    var prices = ViewBag.EstimatedPrices as IDictionary<int, decimal>
        ?? new Dictionary<int, decimal>();
    var airportNames = ViewBag.AirportNames as IDictionary<int, string>
        ?? new Dictionary<int, string>();
    var destinationOrigins = ViewBag.DestinationOrigins as IDictionary<int, string>
        ?? new Dictionary<int, string>();
    var suggestedDates = ViewBag.SuggestedDates as IEnumerable<DateTime>
        ?? Enumerable.Empty<DateTime>();
}

<div class="container py-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h1 class="h4 mb-0">Nueva Reserva</h1>
        </div>
        <div class="card-body">
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            @if (ViewBag.ErrorMessage is string searchError)
            {
                <div class="alert alert-warning">@searchError</div>
            }

            <form method="get" asp-action="Index" class="row g-3 align-items-start">
                <div class="col-md-4">
                    <label for="origin" class="form-label">Origen</label>
                    <select id="origin" name="origin" class="form-select" required>
                        <option value="">Seleccione...</option>
                        @foreach (var airport in (IEnumerable<U3_Examen_Airport.Models.Airport>)ViewBag.Origins)
                        {
                            <option value="@airport.AirportId" selected="@(ViewBag.Origin == (short)airport.AirportId)">
                                @airport.Name.Trim() (@(!string.IsNullOrWhiteSpace(airport.Iata) ? airport.Iata.Trim() : airport.Icao.Trim()))
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="destination" class="form-label">Destino</label>
                    <select id="destination" name="destination" class="form-select" required>
                        <option value="">Seleccione...</option>
                        @foreach (var airport in (IEnumerable<U3_Examen_Airport.Models.Airport>)ViewBag.Destinations)
                        {
                            var validOrigins = destinationOrigins.TryGetValue(
                                airport.AirportId,
                                out var originValues)
                                ? originValues
                                : string.Empty;
                            <option value="@airport.AirportId"
                                    data-origins="@validOrigins"
                                    selected="@(ViewBag.Destination == (short)airport.AirportId)">
                                @airport.Name.Trim() (@(!string.IsNullOrWhiteSpace(airport.Iata) ? airport.Iata.Trim() : airport.Icao.Trim()))
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="date" class="form-label">Fecha</label>
                    <input id="date" name="date" type="date" class="form-control"
                           value="@ViewBag.Date"
                           min="@ViewBag.MinimumFlightDate"
                           max="@ViewBag.MaximumFlightDate"
                           required />
                    <div class="form-text">
                        Fechas del dataset: @ViewBag.MinimumFlightDate a @ViewBag.MaximumFlightDate
                    </div>
                </div>

                <div class="col-md-1 d-grid">
                    <span class="form-label invisible" aria-hidden="true">Acción</span>
                    <button type="submit" class="btn btn-primary">Buscar</button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.HasSearched == true && ViewBag.ErrorMessage is null)
    {
        <div class="card shadow-sm">
            <div class="card-header">
                <h2 class="h5 mb-0">Vuelos disponibles</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Número de vuelo</th>
                            <th>Origen</th>
                            <th>Destino</th>
                            <th>Salida</th>
                            <th>Llegada</th>
                            <th>Precio estimado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var flight in Model)
                        {
                            var estimatedPrice = prices.TryGetValue(
                                flight.FlightId,
                                out var price)
                                ? price
                                : 0m;
                            <tr>
                                <td>@flight.Flightno</td>
                                <td>@(airportNames.TryGetValue(flight.From, out var originName) ? originName : $"Aeropuerto #{flight.From}")</td>
                                <td>@(airportNames.TryGetValue(flight.To, out var destinationName) ? destinationName : $"Aeropuerto #{flight.To}")</td>
                                <td>@flight.Departure.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@flight.Arrival.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>USD @estimatedPrice.ToString("N2")</td>
                                <td>
                                    <a asp-action="Confirm"
                                       asp-route-flightId="@flight.FlightId"
                                       class="btn btn-sm btn-success">
                                        Reservar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="card-body text-center text-muted">
                    <p class="mb-2">No se encontraron vuelos con los filtros seleccionados.</p>
                    @if (suggestedDates.Any())
                    {
                        <p class="mb-2">Pruebe una de estas fechas disponibles para la misma ruta:</p>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            @foreach (var suggestedDate in suggestedDates)
                            {
                                <a asp-action="Index"
                                   asp-route-origin="@ViewBag.Origin"
                                   asp-route-destination="@ViewBag.Destination"
                                   asp-route-date="@suggestedDate.ToString("yyyy-MM-dd")"
                                   class="btn btn-sm btn-outline-primary">
                                    @suggestedDate.ToString("dd/MM/yyyy")
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        (() => {
            const origin = document.getElementById('origin');
            const destination = document.getElementById('destination');
            const destinationOptions = Array.from(destination.options).slice(1);

            function updateDestinations() {
                const selectedOrigin = origin.value;

                destinationOptions.forEach(option => {
                    const validOrigins = (option.dataset.origins || '').split(',');
                    option.hidden = selectedOrigin !== '' && !validOrigins.includes(selectedOrigin);
                    option.disabled = option.hidden;
                });

                if (destination.selectedOptions[0]?.disabled) {
                    destination.value = '';
                }
            }

            origin.addEventListener('change', updateDestinations);
            updateDestinations();
        })();
    </script>
}
